# Campus Customs — environment template
#
# Copy this file to `.env` in this folder (or any parent folder) and fill in
# your key. `.env` is git-ignored; never commit a real key.
#
#   cp .env.example .env
#
# The backend walks up from the project folder through every parent directory
# and loads the first `.env` it finds, so a shared key a few levels up works
# without copying it in here.

# Required for the chat assistant. Catalogue browsing, accounts and the rest of
# the site work without it; /api/health reports "agent_ready": false.
PORTKEY_API_KEY=

# Optional — the Portkey gateway endpoint.
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional — override the model. Defaults to gpt-6-luna.
MODEL_NAME=gpt-6-luna

# Optional — secret used to sign session tokens. Set this to a long random
# string in anything resembling production; a development fallback is used
# when it is absent.
CAMPUS_CUSTOMS_SECRET=
